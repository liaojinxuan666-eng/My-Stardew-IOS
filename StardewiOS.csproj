<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.yourname.stardewios</ApplicationId>
    <ApplicationTitle>StardewiOS</ApplicationTitle>
    <ApplicationVersion>1.0</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- 核心排错配置：按需解释和裁剪 -->
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchInterpreter>MonoGame.Framework.iOS</MtouchInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- 锁定稳定版 MonoGame -->
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.1.303" />
  </ItemGroup>

  <!-- 确保 Content 文件夹内的所有资源（如图片）都被打包进 App -->
  <ItemGroup>
    <BundleResource Include="Content/**/*.*" />
    <None Update="Content/**/*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>